#!/usr/bin/env bash
# Runs scripts/check.sh (the single source of truth for "is this app OK")
# before anything leaves your machine. Auto-fixable changes it produces
# (formatting, lint fixes, and stale swagger/generated client) are committed
# and pushed automatically; a real
# analyze/test failure blocks the push.
#
# Activate with: git config core.hooksPath .githooks

set -euox pipefail

remote_name="$1"
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Git provides the refs being pushed on stdin. Preserve them before invoking
# any checks: a child process may otherwise consume stdin, leaving nothing for
# the auto-fix push below.
mapfile -t push_updates

echo "== pre-push: running checks =="
if ! ./scripts/check.sh; then
  echo
  echo "pre-push: checks failed. Push aborted." >&2
  exit 1
fi

if ! git diff --quiet || [ -n "$(git status --porcelain)" ]; then
  echo "== pre-push: auto-fixed changes detected, committing =="
  git add -A
  git commit -m "chore: auto-fix formatting/lint/generated client [pre-push]"

  echo "== pre-push: pushing auto-fix commit =="
  for update in "${push_updates[@]}"; do
    read -r local_ref _ remote_ref _ <<< "$update"
    [ -z "$local_ref" ] && continue
    git push --no-verify "$remote_name" "HEAD:$remote_ref"
  done

  echo
  echo "pre-push: committed and pushed auto-fixes for you. The original push was replaced by that commit." >&2
  exit 1
fi

exit 0
